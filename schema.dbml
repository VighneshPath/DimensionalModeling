// ============================================================
// Dimensional Model - Global Library Platform
// Based on InitialModeling.md
// ============================================================

// ---- DIMENSIONS ----

Table dim_member {
  member_key   int     [pk]
  member_name  varchar
  email        varchar
  phone        varchar
}

Table dim_branch {
  branch_key      int     [pk]
  branch_name     varchar
  city            varchar
  state_province  varchar
  country         varchar
  local_currency  varchar
}

Table dim_product {
  product_key   int     [pk]
  barcode       varchar
  title         varchar
  product_line  varchar  // Book / Magazine / Journal
}

// Role-playing dimension — used as BorrowDate and ReturnDate
Table dim_date {
  date_key          int     [pk]
  full_date         date
  day_of_week       varchar
  is_weekend        boolean
  is_public_holiday boolean
  month             int
  quarter           int
  year              int
}

// ---- FACTS ----

// Grain: One row per borrowed/returned physical copy per borrow/return transaction
// (e.g. a bill with 3 books = 3 rows)
Table fact_borrow_return {
  key               int  [pk]
  member_key               int  [ref: > dim_member.member_key]
  branch_key               int  [ref: > dim_branch.branch_key]
  product_key              int  [ref: > dim_product.product_key]
  borrow_date_key          int  [ref: > dim_date.date_key]
  due_date_key             int  [ref: > dim_date.date_key]
  return_date_key          int  [ref: > dim_date.date_key] 

  // Measures
  fee_local  decimal
  fee_usd    decimal
  fine_amount_local  decimal
  fine_amount_usd    decimal
  borrow_count      int    // always 1
  days_late          int
  is_lost            boolean
  return_count       int    // always 1 or null
}



// Grain: One row per inventory event for a physical copy
Table fact_inventory {
  inventory_key  int  [pk]
  branch_key     int  [ref: > dim_branch.branch_key]
  product_key    int  [ref: > dim_product.product_key]
  added_date_key       int  [ref: > dim_date.date_key]
  removed_date_key       int  [ref: > dim_date.date_key]

  // Measures
  addition_change_count   int   
  removal_change_count int
}
